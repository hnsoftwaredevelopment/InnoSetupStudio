<Window x:Class="InnoSetupStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InnoSetupStudio.App.Localization"
        Title="{loc:Loc AppTitle}" Height="560" Width="900" Icon="/Resources/AppIcon.ico"
        Background="{DynamicResource Brush.Background}">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{loc:Loc AppTitle}" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
                <TextBlock Text="{loc:Loc MenuLanguage}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="LanguageComboBox" Width="140" SelectionChanged="LanguageComboBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <TextBlock Text="{loc:Loc MenuTheme}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ThemeComboBox" Width="140" SelectionChanged="ThemeComboBox_SelectionChanged" />
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                       VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{loc:Loc WelcomeMessage}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,24" />
            <!-- WrapPanel in plaats van een niet-wrappende horizontale StackPanel (CodeRabbit,
                 PR #18): met de Duitse vertalingen en nu zes knoppen op een rij kan deze rij
                 breder worden dan een versmald venster, waardoor knoppen buiten beeld zouden
                 vallen in plaats van naar een tweede regel door te lopen. -->
            <WrapPanel HorizontalAlignment="Center">
                <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,12,0"
                        Click="NewProjectButton_Click" ToolTip="{loc:Loc ButtonNewProject}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource BuildInstaller}" Fill="White" Stretch="Uniform"
                              Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc ButtonNewProject}" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,12,0" Click="OpenProjectButton_Click" ToolTip="{loc:Loc ButtonOpenProject}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc ButtonOpenProject}" />
                    </StackPanel>
                </Button>
                <Button x:Name="WizardScreensButton" Margin="0,0,12,0" IsEnabled="False"
                        Click="WizardScreensButton_Click" ToolTip="{loc:Loc ButtonWizardScreens}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource List}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc ButtonWizardScreens}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ScreenEditorButton" Margin="0,0,12,0" IsEnabled="False"
                        Click="ScreenEditorButton_Click" ToolTip="{loc:Loc ButtonScreenEditor}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Edit}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc ButtonScreenEditor}" />
                    </StackPanel>
                </Button>
                <!-- Hergebruikt het Document-icoon (geen eigen "talen"-icoon getekend voor deze
                     feature, zie backlogitem 4 sectie 14/19): dat icoon staat elders al voor
                     meerdere, verschillende schermtypes, dus hergebruik hiervoor past bij hoe de
                     rest van de iconenset al wordt ingezet. -->
                <Button x:Name="LanguagesButton" Margin="0,0,12,0" IsEnabled="False"
                        Click="LanguagesButton_Click" ToolTip="{loc:Loc ButtonLanguages}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Document}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc ButtonLanguages}" />
                    </StackPanel>
                </Button>
                <Button ToolTip="{loc:Loc ButtonBuildInstaller}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource BuildInstaller}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc ButtonBuildInstaller}" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </DockPanel>
</Window>
