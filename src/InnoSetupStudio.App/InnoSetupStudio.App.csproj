<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\InnoSetupStudio.Core\InnoSetupStudio.Core.csproj" />
    <ProjectReference Include="..\InnoSetupStudio.Wizard\InnoSetupStudio.Wizard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Alleen voor het renderen van het app-icoon (Resources\AppIcon.svg) op het splashscreen:
         het bronbestand heeft radiale/lineaire gradients en boogsegmenten die zich niet lenen
         voor handgeschreven, rechte-lijnen Geometry zoals de UI-iconen in Icons.xaml. -->
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <PackageReference Include="Syncfusion.Licensing" Version="34.2.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expliciet als Resource (in plaats van te vertrouwen op automatische SDK-globbing, die
         .ico/.svg niet vanzelf als WPF-resource meeneemt zoals wel gebeurt met .xaml): nodig
         zodat Window.Icon en de SvgViewbox op het splashscreen ze via een pack-URI kunnen vinden. -->
    <Resource Include="Resources\AppIcon.ico" />
    <Resource Include="Resources\AppIcon.svg" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Alleen voor System.Windows.Forms.ColorDialog (zie WizardScreenEditorViewModel.PickColor):
         WPF heeft zelf geen ingebouwde kleurenkiezer, en dit is de standaard Windows-kleurenkiezer
         die de gebruiker al kent, in plaats van een eigen WPF-kleurenkiezer te bouwen of een
         extra pakket toe te voegen. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Herbert wil de gebouwde .exe direct terugvinden als InnoSetupStudio.exe in Builds\<Configuration>\,
         niet als InnoSetupStudio.App.exe weggestopt in bin\<Configuration>\net10.0-windows\. AssemblyName
         bepaalt alleen de bestandsnaam van de output, niet de C#/XAML-namespace (die volgt uit
         RootNamespace, dat standaard op de projectnaam blijft staan; geen code-aanpassingen nodig). -->
    <AssemblyName>InnoSetupStudio</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\Builds\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Icoon van de gebouwde .exe zelf (Verkenner, Alt+Tab, taakbalk vóór het eerste venster
         verschijnt). Window.Icon (zie MainWindow/SplashWindow e.a.) regelt het icoon ván een
         geopend venster daarna; dat is een los mechanisme, vandaar beide. -->
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms hierboven (alleen voor System.Windows.Forms.ColorDialog) brengt een
         impliciete global using voor System.Windows.Forms mee, die botst met WPF's eigen
         System.Windows.Application ("Application is ambiguous"). Deze ene impliciete using
         verwijderen is genoeg: overal waar ColorDialog/System.Drawing.Color gebruikt wordt (zie
         WizardScreenEditorViewModel.PickColor) staat de namespace toch al volledig uitgeschreven. -->
    <Using Remove="System.Windows.Forms" />
    <!-- Zelfde reden als hierboven: System.Drawing (Color/ColorConverter/FontFamily) botst met de
         gelijknamige typen in System.Windows.Media die overal elders in de app gebruikt worden. -->
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
