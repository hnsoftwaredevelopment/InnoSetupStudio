<Window x:Class="InnoSetupStudio.App.Views.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InnoSetupStudio.App.Localization"
        Title="{loc:Loc ProjectSettingsTitle}" Height="660" Width="600" Icon="/Resources/AppIcon.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" ToolTip="{loc:Loc ButtonSave}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Check}" Fill="White" Stretch="Uniform"
                          Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc ButtonSave}" />
                </StackPanel>
            </Button>
            <Button Command="{Binding CancelCommand}" ToolTip="{Binding CancelButtonText}">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="{DynamicResource Brush.TextPrimary}"
                          Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource Close}" />
                                <Style.Triggers>
                                    <!-- Zelfde map-icoon als de Bladeren-knoppen hieronder: bij een
                                         al bestaand project sluit deze knop alleen het venster
                                         (het project blijft open), dus een kruis-icoon past dan
                                         niet meer bij het "Openen"-label. -->
                                    <DataTrigger Binding="{Binding IsExistingProject}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource Folder}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock Text="{Binding CancelButtonText}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:Loc SectionGeneral}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AppNameLabel" Grid.Column="0" Text="{loc:Loc LabelAppName}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=AppNameLabel}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AppVersionLabel" Grid.Column="0" Text="{loc:Loc LabelAppVersion}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding AppVersion, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=AppVersionLabel}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PublisherLabel" Grid.Column="0" Text="{loc:Loc LabelPublisher}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=PublisherLabel}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PublisherEmailLabel" Grid.Column="0" Text="{loc:Loc LabelPublisherEmail}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PublisherEmail, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=PublisherEmailLabel}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PublisherUrlLabel" Grid.Column="0" Text="{loc:Loc LabelPublisherUrl}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PublisherUrl, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=PublisherUrlLabel}" />
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AppIdLabel" Grid.Column="0" Text="{loc:Loc LabelAppId}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding AppId, Mode=OneWay}" IsReadOnly="True"
                             Foreground="{DynamicResource Brush.TextSecondary}"
                             AutomationProperties.LabeledBy="{Binding ElementName=AppIdLabel}" />
                </Grid>

                <TextBlock Text="{loc:Loc SectionFileLocations}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SourceFilesPathLabel" Grid.Column="0" Text="{loc:Loc LabelSourceFilesPath}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SourceFilesPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                             AutomationProperties.LabeledBy="{Binding ElementName=SourceFilesPathLabel}" />
                    <Button Grid.Column="2" Command="{Binding BrowseSourceFilesCommand}" ToolTip="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OutputPathLabel" Grid.Column="0" Text="{loc:Loc LabelOutputPath}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                             AutomationProperties.LabeledBy="{Binding ElementName=OutputPathLabel}" />
                    <Button Grid.Column="2" Command="{Binding BrowseOutputCommand}" ToolTip="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CustomImagesPathLabel" Grid.Column="0" Text="{loc:Loc LabelCustomImagesPath}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding CustomImagesPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                             AutomationProperties.LabeledBy="{Binding ElementName=CustomImagesPathLabel}" />
                    <Button Grid.Column="2" Command="{Binding BrowseCustomImagesCommand}" ToolTip="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SetupIconFileLabel" Grid.Column="0" Text="{loc:Loc LabelSetupIconFile}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SetupIconFile, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                             AutomationProperties.LabeledBy="{Binding ElementName=SetupIconFileLabel}" />
                    <Button Grid.Column="2" Command="{Binding BrowseIconCommand}" ToolTip="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
