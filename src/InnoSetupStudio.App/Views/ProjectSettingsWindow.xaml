<Window x:Class="InnoSetupStudio.App.Views.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InnoSetupStudio.App.Localization"
        xmlns:converters="clr-namespace:InnoSetupStudio.App.Converters"
        Title="{loc:Loc ProjectSettingsTitle}" Height="660" Width="640" Icon="/Resources/AppIcon.ico"
        MinHeight="500" MinWidth="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}">
    <Window.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />

        <!-- Schermen/Talen-tabblad (sectie 21): dezelfde rij-template als voorheen in de eigen
             WizardScreensWindow/LanguagesWindow, nu hergebruikt als DataTemplate hier. Talen heeft
             een extra IsLocked-trigger (Engels blijft aangevinkt en uitgeschakeld), Schermen niet. -->
        <DataTemplate x:Key="CheckableRowTemplate">
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="14" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding DisplayName}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Wizardschermen-rij heeft geen IsLocked (elk scherm mag uit), maar wél IsEnabled als
             eigenschapsnaam voor het vinkje zelf (WizardScreenRow) in plaats van IsSelected
             (LanguageRow) — vandaar een tweede, bijna identieke template in plaats van hergebruik. -->
        <DataTemplate x:Key="ScreenRowTemplate">
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4"
                            Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,12,0">
                        <Path Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                              Fill="{DynamicResource Brush.TextSecondary}" Stretch="Uniform" Width="16" Height="16" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="14" />
                    <CheckBox Grid.Column="3" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding DisplayName}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" ToolTip="{loc:Loc ButtonSave}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Check}" Fill="White" Stretch="Uniform"
                          Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc ButtonSave}" />
                </StackPanel>
            </Button>
            <Button Command="{Binding CancelCommand}" ToolTip="{Binding CancelButtonText}">
                <StackPanel Orientation="Horizontal">
                    <!-- Zelfde map-icoon als de Bladeren-knoppen hieronder bij "Openen" (een al
                         bestaand project: deze knop sluit dan alleen het venster, het project
                         blijft open); kruis bij "Annuleren". CancelButtonIconKey komt uit
                         DirtyTrackingViewModel, zie ProjectSettingsViewModel voor de override. -->
                    <Path Data="{Binding CancelButtonIconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                          Fill="{DynamicResource Brush.TextPrimary}"
                          Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding CancelButtonText}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Sectie 21: Schermen (voorheen WizardScreensWindow) en Talen (voorheen LanguagesWindow,
             sectie 19) zijn hier tabbladen geworden — Herbert: "dit zie ik allemaal als
             projectinstellingen". De Algemeen-tab hieronder is verder ongewijzigd. -->
        <TabControl IsEnabled="{Binding CanEdit}">
        <TabItem Header="{loc:Loc SectionGeneral}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="{loc:Loc SectionGeneral}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AppNameLabel" Grid.Column="0" Text="{loc:Loc LabelAppName}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=AppNameLabel}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AppVersionLabel" Grid.Column="0" Text="{loc:Loc LabelAppVersion}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding AppVersion, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=AppVersionLabel}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PublisherLabel" Grid.Column="0" Text="{loc:Loc LabelPublisher}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=PublisherLabel}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PublisherEmailLabel" Grid.Column="0" Text="{loc:Loc LabelPublisherEmail}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PublisherEmail, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=PublisherEmailLabel}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PublisherUrlLabel" Grid.Column="0" Text="{loc:Loc LabelPublisherUrl}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PublisherUrl, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=PublisherUrlLabel}" />
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AppIdLabel" Grid.Column="0" Text="{loc:Loc LabelAppId}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding AppId, Mode=OneWay}" IsReadOnly="True"
                             Foreground="{DynamicResource Brush.TextSecondary}"
                             AutomationProperties.LabeledBy="{Binding ElementName=AppIdLabel}" />
                </Grid>

                <TextBlock Text="{loc:Loc SectionFileLocations}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SourceFilesPathLabel" Grid.Column="0" Text="{loc:Loc LabelSourceFilesPath}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SourceFilesPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                             AutomationProperties.LabeledBy="{Binding ElementName=SourceFilesPathLabel}" />
                    <Button Grid.Column="2" Command="{Binding BrowseSourceFilesCommand}" ToolTip="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OutputPathLabel" Grid.Column="0" Text="{loc:Loc LabelOutputPath}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                             AutomationProperties.LabeledBy="{Binding ElementName=OutputPathLabel}" />
                    <Button Grid.Column="2" Command="{Binding BrowseOutputCommand}" ToolTip="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CustomImagesPathLabel" Grid.Column="0" Text="{loc:Loc LabelCustomImagesPath}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding CustomImagesPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                             AutomationProperties.LabeledBy="{Binding ElementName=CustomImagesPathLabel}" />
                    <Button Grid.Column="2" Command="{Binding BrowseCustomImagesCommand}" ToolTip="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SetupIconFileLabel" Grid.Column="0" Text="{loc:Loc LabelSetupIconFile}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SetupIconFile, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                             AutomationProperties.LabeledBy="{Binding ElementName=SetupIconFileLabel}" />
                    <Button Grid.Column="2" Command="{Binding BrowseIconCommand}" ToolTip="{loc:Loc ButtonBrowse}"
                            AutomationProperties.Name="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>

                <!-- Wizardafbeeldingen (WizardImageFile/WizardSmallImageFile) stonden hier tot
                     backlogitem 1 (sectie 14): ze worden nu op het Standaardscherm in de
                     schermeditor bewerkt (ScreenEditorControl.xaml,
                     DefaultScreenPropertyPanelTemplate), samen met de andere pagina-brede
                     standaardwaarden, in plaats van hier los van die editor. -->
            </StackPanel>
        </ScrollViewer>
        </TabItem>

        <TabItem Header="{loc:Loc TabScreens}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="{loc:Loc WizardScreensIntro}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding WizardScreens}" ItemTemplate="{StaticResource ScreenRowTemplate}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{loc:Loc LanguagesTitle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="{loc:Loc LanguagesIntro}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Languages}" ItemTemplate="{StaticResource CheckableRowTemplate}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Overige instellingen (backlogitem 3, sectie 25): instellingen die niet bij één
             specifiek wizardscherm horen. Bewust beperkt tot de drie groepen die Herbert zelf
             noemde (zie InstallerProject voor de uitleg per veld) - de rest van zijn Inno Script
             Studio-referentieschermen komt later, mogelijk als eigen tabbladen. -->
        <TabItem Header="{loc:Loc TabOtherSettings}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="{loc:Loc SectionDesktopShortcut}" FontSize="15" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Loc HintDesktopShortcut}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" />
                    <CheckBox Content="{loc:Loc LabelCreateDesktopIcon}" IsChecked="{Binding CreateDesktopIcon}"
                               Margin="0,0,0,20" />

                    <TextBlock Text="{loc:Loc SectionStartMenu}" FontSize="15" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Loc HintStartMenu}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" />
                    <CheckBox Content="{loc:Loc LabelCreateStartMenuIcon}" IsChecked="{Binding CreateStartMenuIcon}"
                               Margin="0,0,0,20" />

                    <TextBlock Text="{loc:Loc SectionUpdateCapability}" FontSize="15" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Loc HintUpdateCapability}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8" />
                    <CheckBox Content="{loc:Loc LabelUsePreviousAppDir}" IsChecked="{Binding UsePreviousAppDir}" Margin="0,0,0,8" />
                    <CheckBox Content="{loc:Loc LabelUsePreviousGroup}" IsChecked="{Binding UsePreviousGroup}" Margin="0,0,0,8" />
                    <CheckBox Content="{loc:Loc LabelUsePreviousSetupType}" IsChecked="{Binding UsePreviousSetupType}" Margin="0,0,0,8" />
                    <CheckBox Content="{loc:Loc LabelUsePreviousTasks}" IsChecked="{Binding UsePreviousTasks}" Margin="0,0,0,8" />
                    <CheckBox Content="{loc:Loc LabelUsePreviousLanguage}" IsChecked="{Binding UsePreviousLanguage}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        </TabControl>
    </DockPanel>
</Window>
