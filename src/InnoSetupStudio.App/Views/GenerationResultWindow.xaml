<Window x:Class="InnoSetupStudio.App.Views.GenerationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InnoSetupStudio.App.Localization"
        Title="{loc:Loc GenerateResultTitle}" Height="440" Width="720" MinHeight="300" MinWidth="520"
        Icon="/Resources/AppIcon.ico" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}">
    <!-- Resultaat van "Genereer .iss" (stap 3 van docs/Ontwerp-Dunne-Generator.md): waar het script
         staat (of dat er geen is geschreven) en de meldingen van de generator, fouten eerst. De
         teksten komen uit GenerationIssueFormatter, dus in de actieve UI-taal. -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OpenFolderButton" Margin="0,0,8,0" Click="OpenFolderButton_Click"
                    Content="{loc:Loc GenerateOpenFolder}" />
            <Button Style="{StaticResource AccentButtonStyle}" IsDefault="True" IsCancel="True"
                    Content="{loc:Loc ButtonClose}" Click="CloseButton_Click" />
        </StackPanel>

        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12" />

        <Grid>
            <TextBlock x:Name="NoIssuesText" Text="{loc:Loc GenerateResultNoIssues}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
            <ListBox x:Name="IssuesList" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Focusable="False">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SeverityText" Grid.Column="0" Text="{Binding SeverityLabel}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                        </Grid>
                        <!-- De ernst staat altijd als tekst; de kleur komt uit de thema-penselen
                             (alle thema's definiëren Brush.Danger en Brush.Warning). -->
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                <Setter TargetName="SeverityText" Property="Foreground"
                                        Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                <Setter TargetName="SeverityText" Property="Foreground"
                                        Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
