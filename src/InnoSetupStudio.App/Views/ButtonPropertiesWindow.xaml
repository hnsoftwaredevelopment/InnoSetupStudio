<Window x:Class="InnoSetupStudio.App.Views.ButtonPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InnoSetupStudio.App.Localization"
        xmlns:converters="clr-namespace:InnoSetupStudio.App.Converters"
        xmlns:controls="clr-namespace:InnoSetupStudio.App.Controls"
        xmlns:services="clr-namespace:InnoSetupStudio.App.Services"
        Title="{Binding DialogTitle}" Height="620" Width="420" Icon="/Resources/AppIcon.ico"
        MinHeight="560" MinWidth="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}">
    <!-- Knop-eigenschappenscherm (backlogitem 3, sectie 17): één herbruikbaar dialoogvenster voor
         de eigenschappen van een willekeurige knop, geopend vanaf het properties-knopje achter elk
         van de drie tekstvelden (Terug/Volgende/Annuleren) in WizardEditorWindow.xaml, en voor de
         Bladerknop op het Bestemmingsscherm. Zie ButtonPropertiesViewModel voor waarom dit als een
         adapter met get/set-delegates werkt in plaats van rechtstreeks op
         WizardScreenEditorViewModel/DefaultScreenEditorViewModel/
         SelectDestinationPageEditorViewModel te binden. -->
    <Window.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
        <converters:FontFamilyOrUnsetConverter x:Key="FontFamilyOrUnsetConverter" />
        <converters:FontSizeOrUnsetConverter x:Key="FontSizeOrUnsetConverter" />
        <converters:NullableBoolToFontWeightConverter x:Key="NullableBoolToFontWeightConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" ToolTip="{loc:Loc ButtonSave}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Check}" Fill="White" Stretch="Uniform"
                          Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc ButtonSave}" />
                </StackPanel>
            </Button>
            <Button Command="{Binding CancelCommand}" ToolTip="{Binding CancelButtonText}">
                <StackPanel Orientation="Horizontal">
                    <!-- CancelButtonText/CancelButtonIconKey komen uit DirtyTrackingViewModel:
                         "Sluiten" met een pijltje zolang er in dit dialoogvenster niets is
                         gewijzigd, "Annuleren" met een kruis zodra dat wel zo is (die wijziging
                         wordt dan weggegooid in plaats van opgeslagen - zie
                         ButtonPropertiesViewModel voor waarom dat hier voldoende is). -->
                    <Path Data="{Binding CancelButtonIconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                          Fill="{DynamicResource Brush.TextPrimary}"
                          Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding CancelButtonText}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Visibility="{Binding HasCaption, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,0,0,12">
                    <TextBlock x:Name="CaptionLabel" Text="{loc:Loc LabelButtonCaption}" Margin="0,0,0,4" />
                    <!-- Foreground volgt de (nog niet opgeslagen) tekstkleur hieronder, precies
                         zoals Herberts mockup vraagt: "hier kan de knoptekst al in worden
                         aangepast en wordt getoond in de geselecteerde kleur". -->
                    <TextBox Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="{Binding PreviewTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                             controls:Placeholder.Text="{Binding EffectiveCaption}"
                             AutomationProperties.LabeledBy="{Binding ElementName=CaptionLabel}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock x:Name="TextColorLabel" Text="{loc:Loc LabelButtonTextColor}" Width="96" VerticalAlignment="Center" />
                    <Border Width="20" Height="20" BorderBrush="#FFACA899" BorderThickness="1" Margin="0,0,6,0"
                            Background="{Binding PreviewTextColor, Converter={StaticResource HexColorToBrushConverter}}" />
                    <TextBox Width="100" Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                             controls:Placeholder.Text="{Binding EffectiveTextColor}"
                             AutomationProperties.LabeledBy="{Binding ElementName=TextColorLabel}" />
                    <Button Command="{Binding PickTextColorCommand}" ToolTip="{loc:Loc ButtonSelectColor}"
                            AutomationProperties.Name="{loc:Loc ButtonSelectColor}">
                        <Path Data="{StaticResource SelectColor}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock x:Name="FontFamilyLabel" Text="{loc:Loc LabelButtonFontFamily}" Margin="0,0,0,4" />
                    <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                              ItemsSource="{x:Static services:SystemFontCatalog.FontFamilyNames}"
                              Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}"
                              controls:Placeholder.Text="{Binding EffectiveFontFamily}"
                              AutomationProperties.LabeledBy="{Binding ElementName=FontFamilyLabel}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock x:Name="FontSizeLabel" Text="{loc:Loc LabelButtonFontSize}" Width="96" VerticalAlignment="Center" />
                    <!-- Herberts mockup noemt expliciet +/- knopjes als voorbeeld, maar staat
                         nadrukkelijk een andere manier toe ("mag ook op een andere manier"): dit
                         hergebruikt dezelfde eenvoudige TextBox als de rest van de app (zie
                         WizardEditorWindow.xaml), in plaats van een nieuwe NumericUpDown-achtige
                         besturingselement voor deze ene dialoog te bouwen. -->
                    <TextBox Width="70" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"
                             controls:Placeholder.Text="{Binding EffectiveFontSize}"
                             AutomationProperties.LabeledBy="{Binding ElementName=FontSizeLabel}" />
                    <CheckBox Content="{loc:Loc LabelButtonFontBold}" IsChecked="{Binding FontBold}" IsThreeState="True" />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock x:Name="TooltipLabel" Text="{loc:Loc LabelButtonTooltip}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Tooltip, UpdateSourceTrigger=PropertyChanged}"
                             controls:Placeholder.Text="{Binding EffectiveTooltip}"
                             AutomationProperties.LabeledBy="{Binding ElementName=TooltipLabel}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="{loc:Loc LabelButtonEnabled}" IsChecked="{Binding ButtonEnabled}"
                                  IsThreeState="True" Margin="0,0,16,0" />
                        <CheckBox Content="{loc:Loc LabelButtonVisible}" IsChecked="{Binding ButtonVisible}"
                                  IsThreeState="True" />
                    </StackPanel>
                    <TextBlock Text="{Binding TriStateHint}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Text="{loc:Loc SectionPreview}" FontWeight="Bold" Margin="0,16,0,8" />
                <Border BorderBrush="#FFACA899" BorderThickness="1" Padding="16" HorizontalAlignment="Left">
                    <!-- Zelfde live-voorvertoning-aanpak als het bestaande Schermeditor-paneel
                         (WizardEditorWindow.xaml): Preview*-eigenschappen lossen leeg/onbepaald op
                         naar de meegegeven terugvalwaarde, net als Effective* daar. Geen
                         Background/afgeronde-hoeken-binding: TNewButton is een door Windows
                         getekende standaardknop zonder die twee eigenschappen (Herberts
                         2026-09-04-beslissing, zie WizardScreenButtonSettings). -->
                    <Button Padding="12,4" MinWidth="80"
                            Foreground="{Binding PreviewTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                            FontFamily="{Binding PreviewFontFamily, Converter={StaticResource FontFamilyOrUnsetConverter}}"
                            FontSize="{Binding PreviewFontSize, Converter={StaticResource FontSizeOrUnsetConverter}}"
                            FontWeight="{Binding FontBold, Converter={StaticResource NullableBoolToFontWeightConverter}}"
                            ToolTip="{Binding PreviewTooltip}">
                        <TextBlock Text="{Binding PreviewButtonText}" />
                    </Button>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
