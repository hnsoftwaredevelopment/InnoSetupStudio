<UserControl x:Class="InnoSetupStudio.App.Views.ScreenEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InnoSetupStudio.App.Localization"
             xmlns:converters="clr-namespace:InnoSetupStudio.App.Converters"
             xmlns:controls="clr-namespace:InnoSetupStudio.App.Controls"
             xmlns:vm="clr-namespace:InnoSetupStudio.App.ViewModels.Screens"
             xmlns:services="clr-namespace:InnoSetupStudio.App.Services"
             xmlns:wizard="clr-namespace:InnoSetupStudio.Wizard.Screens;assembly=InnoSetupStudio.Wizard"
             Background="{DynamicResource Brush.Background}">
    <!-- Voormalig WizardEditorWindow (sectie 21, IDE-schil herontwerp): dezelfde inhoud, nu
         permanent zichtbaar in MainWindow in plaats van een apart dialoogvenster. De
         schermselectie-ListBoxen, de voorvertoning en het instellingenpaneel hieronder zijn
         functioneel ongewijzigd overgenomen; alleen de Opslaan/Annuleren-knoppenbalk (die het
         venster sloot) is vervangen door een inline Opslaan-balk die niets sluit, zie onderaan
         dit bestand en ScreenEditorControl.xaml.cs. -->
    <UserControl.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
        <converters:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
        <converters:FontFamilyOrUnsetConverter x:Key="FontFamilyOrUnsetConverter" />
        <converters:FontSizeOrUnsetConverter x:Key="FontSizeOrUnsetConverter" />
        <converters:NullableBoolToFontWeightConverter x:Key="NullableBoolToFontWeightConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Gedeeld door beide lijsten hieronder (het Standaardscherm bovenaan en de echte
             installerschermen eronder): icoon + naam, hetzelfde voor allebei. Beide VM-typen
             (DefaultScreenEditorViewModel en WizardScreenEditorViewModel) hebben een Title- en
             IconKey-eigenschap met dezelfde naam, dus deze ene template werkt voor beide zonder
             DataType-onderscheid. -->
        <DataTemplate x:Key="ScreenRowTemplate">
            <Grid Margin="6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                      Fill="{DynamicResource Brush.TextSecondary}" Stretch="Uniform"
                      Width="14" Height="14" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <!-- Gedeeld door alle drie de instellingenpanelen hieronder (Welkom/Licentie/Bestemming):
             Terug-/Volgende-/Annuleren-knop per scherm aanpasbaar maken. Staat op de basisklasse
             WizardScreenEditorViewModel, dus deze template werkt voor elk schermtype zonder een
             eigen kopie per scherm. Vereenvoudigd (backlogitem 3, sectie 17, Herberts mockup): in
             plaats van alle negen velden per knop hier rechtstreeks te tonen, nu nog maar één
             tekstveld per knop (meteen bewerkbaar, getoond in de knop zijn eigen - of
             overgeërfde, als grijze hint - tekstkleur) plus een klein eigenschappenknopje ernaast
             dat het Knop-eigenschappenscherm opent (ButtonPropertiesWindow, sectie 21: blijft een
             eigen venster) met alle overige velden: kleur, lettertype, grootte, vet, tooltip,
             ingeschakeld/zichtbaar. Zie ScreenEditorControl.xaml.cs/ButtonProperties_Click voor
             hoe dat knopje via zijn Tag ("Back"/"Next"/"Cancel") en de DataContext hier
             (WizardScreenEditorViewModel of DefaultScreenEditorViewModel) de juiste
             ButtonPropertiesViewModel opbouwt. -->
        <DataTemplate x:Key="ButtonSettingsSectionTemplate">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="{loc:Loc SectionWizardButtons}" FontWeight="Bold" Margin="0,0,0,8" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="224" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BackButtonCaptionBox" Grid.Column="0" Width="220" HorizontalAlignment="Left"
                             MaxLength="30"
                             Text="{Binding BackButtonCaption, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                             Foreground="{Binding EffectiveBackButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                             controls:Placeholder.Text="{Binding EffectiveBackButtonCaption}" />
                    <Button Grid.Column="1" Tag="Back" Click="ButtonProperties_Click"
                            ToolTip="{loc:Loc ButtonOpenProperties}" AutomationProperties.Name="{loc:Loc ButtonOpenProperties}"
                            AutomationProperties.LabeledBy="{Binding ElementName=BackButtonCaptionBox}">
                        <Path Data="{StaticResource Properties}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="224" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NextButtonCaptionBox" Grid.Column="0" Width="220" HorizontalAlignment="Left"
                             MaxLength="30"
                             Text="{Binding NextButtonCaption, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                             Foreground="{Binding EffectiveNextButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                             controls:Placeholder.Text="{Binding EffectiveNextButtonCaption}" />
                    <Button Grid.Column="1" Tag="Next" Click="ButtonProperties_Click"
                            ToolTip="{loc:Loc ButtonOpenProperties}" AutomationProperties.Name="{loc:Loc ButtonOpenProperties}"
                            AutomationProperties.LabeledBy="{Binding ElementName=NextButtonCaptionBox}">
                        <Path Data="{StaticResource Properties}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="224" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CancelButtonCaptionBox" Grid.Column="0" Width="220" HorizontalAlignment="Left"
                             MaxLength="30"
                             Text="{Binding CancelButtonCaption, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                             Foreground="{Binding EffectiveCancelButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                             controls:Placeholder.Text="{Binding EffectiveCancelButtonCaption}" />
                    <Button Grid.Column="1" Tag="Cancel" Click="ButtonProperties_Click"
                            ToolTip="{loc:Loc ButtonOpenProperties}" AutomationProperties.Name="{loc:Loc ButtonOpenProperties}"
                            AutomationProperties.LabeledBy="{Binding ElementName=CancelButtonCaptionBox}">
                        <Path Data="{StaticResource Properties}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>

                <TextBlock Text="{Binding HintButtonCaptionEmptyText}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Voorvertoning (midden): per schermtype de bijbehorende UserControl uit
             InnoSetupStudio.Wizard. Die controls kennen deze ViewModel-klassen niet (Wizard
             verwijst alleen naar Core, niet naar App, om een cirkelverwijzing met App te
             voorkomen); de binding werkt via de DataContext die WPF hier automatisch doorgeeft,
             niet via een compile-time koppeling. -->
        <DataTemplate DataType="{x:Type vm:WelcomePageEditorViewModel}">
            <wizard:WelcomePagePreview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LicensePageEditorViewModel}">
            <wizard:LicensePagePreview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InfoBeforePageEditorViewModel}">
            <wizard:InfoBeforePagePreview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserInfoPageEditorViewModel}">
            <wizard:UserInfoPagePreview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SelectDestinationPageEditorViewModel}">
            <wizard:SelectDestinationPagePreview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SelectProgramGroupPageEditorViewModel}">
            <wizard:SelectProgramGroupPagePreview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReadyPageEditorViewModel}">
            <wizard:ReadyPagePreview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InfoAfterPageEditorViewModel}">
            <wizard:InfoAfterPagePreview />
        </DataTemplate>

        <!-- Instellingenpaneel (rechts, nu het middendeel van MainWindow): staat wél hier in
             InnoSetupStudio.App, want dit gebruikt LocalizationManager (via loc:Loc) en de
             thema-brushes van de studio zelf — in tegenstelling tot de voorvertoning hierboven,
             die bewust Inno Setup's eigen vaste wit/zwart-kleuren gebruikt in plaats van het
             thema van de studio. -->
        <DataTemplate DataType="{x:Type vm:WelcomePageEditorViewModel}" x:Key="PropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc ScreenEditorWelcomeInfo}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonSettingsSectionTemplate}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LicensePageEditorViewModel}" x:Key="LicensePropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc LabelLicenseFilePath}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding LicenseFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Command="{Binding BrowseCommand}" ToolTip="{loc:Loc ButtonBrowse}"
                            AutomationProperties.Name="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonSettingsSectionTemplate}" />
            </StackPanel>
        </DataTemplate>

        <!-- Info Before/After (hieronder): functioneel identiek aan de licentiepagina hierboven
             (bestand kiezen + voorvertoning van de inhoud), alleen een andere labeltekst en geen
             "akkoord"-keuzerondjes (zie InfoBeforePagePreview/InfoAfterPagePreview). -->
        <DataTemplate DataType="{x:Type vm:InfoBeforePageEditorViewModel}" x:Key="InfoBeforePropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc LabelInfoBeforeFilePath}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding InfoFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Command="{Binding BrowseCommand}" ToolTip="{loc:Loc ButtonBrowse}"
                            AutomationProperties.Name="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonSettingsSectionTemplate}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InfoAfterPageEditorViewModel}" x:Key="InfoAfterPropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc LabelInfoAfterFilePath}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding InfoFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Command="{Binding BrowseCommand}" ToolTip="{loc:Loc ButtonBrowse}"
                            AutomationProperties.Name="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonSettingsSectionTemplate}" />
            </StackPanel>
        </DataTemplate>

        <!-- User Info: drie vooringevulde tekstvelden plus het "onthoud bij update"-vinkje, geen
             bestandskeuze of eigen knop (zie UserInfoPageEditorViewModel). -->
        <DataTemplate DataType="{x:Type vm:UserInfoPageEditorViewModel}" x:Key="UserInfoPropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc LabelDefaultUserInfoName}" Margin="0,0,0,6" />
                <TextBox Text="{Binding DefaultUserInfoName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="{loc:Loc LabelDefaultUserInfoOrg}" Margin="0,0,0,6" />
                <TextBox Text="{Binding DefaultUserInfoOrg, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="{loc:Loc LabelDefaultUserInfoSerial}" Margin="0,0,0,6" />
                <TextBox Text="{Binding DefaultUserInfoSerial, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <CheckBox Content="{loc:Loc LabelUsePreviousUserInfo}" IsChecked="{Binding UsePreviousUserInfo}"
                          Foreground="{DynamicResource Brush.TextPrimary}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonSettingsSectionTemplate}" />
            </StackPanel>
        </DataTemplate>

        <!-- Select Start Menu Folder: vooringevulde groepsnaam + twee gedragsvinkjes (zie
             SelectProgramGroupPageEditorViewModel; geen eigen Bladeren-knopstijl zoals de
             bestemmingspagina, dit scherm heeft geen eigen aanpasbare knop). -->
        <DataTemplate DataType="{x:Type vm:SelectProgramGroupPageEditorViewModel}" x:Key="SelectProgramGroupPropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc LabelDefaultGroupName}" Margin="0,0,0,6" />
                <TextBox Text="{Binding DefaultGroupName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                <TextBlock Text="{loc:Loc LabelDefaultGroupNameHint}" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,16" />
                <CheckBox Content="{loc:Loc LabelAppendDefaultGroupName}" IsChecked="{Binding AppendDefaultGroupName}"
                          Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,8" />
                <CheckBox Content="{loc:Loc LabelAlwaysUsePersonalGroup}" IsChecked="{Binding AlwaysUsePersonalGroup}"
                          Foreground="{DynamicResource Brush.TextPrimary}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonSettingsSectionTemplate}" />
            </StackPanel>
        </DataTemplate>

        <!-- Klaar om te installeren: drie vinkjes die bepalen wat de samenvatting (ReadyMemo) op
             deze pagina toont (zie ReadyPageEditorViewModel). -->
        <DataTemplate DataType="{x:Type vm:ReadyPageEditorViewModel}" x:Key="ReadyPropertyPanelTemplate">
            <StackPanel>
                <CheckBox Content="{loc:Loc LabelDisableReadyMemo}" IsChecked="{Binding DisableReadyMemo}"
                          Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,8" />
                <CheckBox Content="{loc:Loc LabelAlwaysShowDirOnReadyPage}" IsChecked="{Binding AlwaysShowDirOnReadyPage}"
                          Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,8" />
                <CheckBox Content="{loc:Loc LabelAlwaysShowGroupOnReadyPage}" IsChecked="{Binding AlwaysShowGroupOnReadyPage}"
                          Foreground="{DynamicResource Brush.TextPrimary}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonSettingsSectionTemplate}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SelectDestinationPageEditorViewModel}" x:Key="SelectDestinationPropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc LabelDefaultDirName}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding DefaultDirName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Command="{Binding BrowseCommand}" ToolTip="{loc:Loc ButtonBrowse}"
                            AutomationProperties.Name="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>
                <TextBlock Text="{loc:Loc LabelDefaultDirNameHint}" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,16" />
                <CheckBox Content="{loc:Loc LabelAllowUserToChangeDir}" IsChecked="{Binding AllowUserToChangeDir}"
                          Foreground="{DynamicResource Brush.TextPrimary}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonSettingsSectionTemplate}" />

                <!-- Schermspecifieke "Bladeren"-knop (Inno Setup's WizardForm.DirBrowseButton,
                     zie BrowseButtonSettings): bewust een eigen sectie, los van
                     ButtonSettingsSectionTemplate hierboven (Terug/Volgende/Annuleren) — deze knop
                     komt maar op dit scherm voor. Sinds 2026-09-29 wél een eigen tekstveld, net als
                     de drie knoppen hierboven (zelfde MaxLength/breedte, na een geverifieerde
                     webzoekopdracht: DirBrowseButton is net als de andere drie een TNewButton met
                     Caption). -->
                <TextBlock Text="{loc:Loc SectionBrowseButton}" FontWeight="Bold" Margin="0,20,0,8" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="224" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BrowseButtonCaptionBox" Grid.Column="0" Width="220" HorizontalAlignment="Left"
                             MaxLength="30"
                             Text="{Binding BrowseButtonCaption, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                             Foreground="{Binding BrowseButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                             controls:Placeholder.Text="{Binding EffectiveBrowseButtonCaption}" />
                    <Button Grid.Column="1" Click="BrowseButtonProperties_Click"
                            ToolTip="{loc:Loc ButtonOpenProperties}" AutomationProperties.Name="{loc:Loc ButtonOpenProperties}"
                            AutomationProperties.LabeledBy="{Binding ElementName=BrowseButtonCaptionBox}">
                        <Path Data="{StaticResource Properties}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Het Standaardscherm (§12.6/§12.7): de toelichting, de twee wizardafbeeldingen
             (backlogitem 1, sectie 14) en daaronder dezelfde ButtonSettingsSectionTemplate als de
             drie echte schermen hierboven — dit VM-type heeft dezelfde negen knopvelden (zie
             DefaultScreenEditorViewModel), dus die gedeelde template werkt hier ongewijzigd. -->
        <DataTemplate DataType="{x:Type vm:DefaultScreenEditorViewModel}" x:Key="DefaultScreenPropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc ScreenEditorDefaultScreenInfo}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" />

                <TextBlock Text="{loc:Loc SectionWizardImages}" FontWeight="Bold" Margin="0,20,0,8" />

                <TextBlock x:Name="WizardImageFileLabel" Text="{loc:Loc LabelWizardImageFile}" Margin="0,0,0,4" />
                <!-- Grid in plaats van de vaste-breedte StackPanel van vóór 2026-09-29: net als
                     DefaultDirName hierboven hoeft dit padveld niet ingekort te worden (Herberts
                     feedback) — de TextBox vult nu de resterende breedte (Width="*") in plaats van
                     een vaste Width="180". -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="26" Height="50" BorderBrush="#FFACA899" BorderThickness="1" Margin="0,0,8,0" Background="White">
                        <Image Source="{Binding WizardImage}" Stretch="UniformToFill" />
                    </Border>
                    <TextBox Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                             Text="{Binding WizardImageFile, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=WizardImageFileLabel}" />
                    <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding BrowseWizardImageCommand}" ToolTip="{loc:Loc ButtonBrowse}"
                            AutomationProperties.Name="{loc:Loc ButtonBrowse}"
                            AutomationProperties.LabeledBy="{Binding ElementName=WizardImageFileLabel}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>

                <TextBlock x:Name="WizardSmallImageFileLabel" Text="{loc:Loc LabelWizardSmallImageFile}" Margin="0,0,0,4" />
                <!-- Zelfde Grid-ombouw als bij WizardImageFile hierboven, zelfde reden. -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="30" Height="30" BorderBrush="#FFACA899" BorderThickness="1" Margin="0,0,8,0" Background="White">
                        <Image Source="{Binding WizardSmallImage}" Stretch="UniformToFill" />
                    </Border>
                    <TextBox Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                             Text="{Binding WizardSmallImageFile, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{Binding ElementName=WizardSmallImageFileLabel}" />
                    <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding BrowseWizardSmallImageCommand}" ToolTip="{loc:Loc ButtonBrowse}"
                            AutomationProperties.Name="{loc:Loc ButtonBrowse}"
                            AutomationProperties.LabeledBy="{Binding ElementName=WizardSmallImageFileLabel}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>

                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonSettingsSectionTemplate}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="20">
        <!-- Vervangt de vroegere Opslaan/Sluiten-knoppenbalk van WizardEditorWindow (die het
             dialoogvenster sloot): dit is geen dialoog meer, dus alleen een Opslaan-knop, actief
             zolang er niet-opgeslagen wijzigingen zijn (IsDirty). "Annuleren" heeft hier geen
             zinvolle betekenis meer — er is geen venster om te sluiten zonder op te slaan, de
             wijzigingen staan gewoon in het scherm totdat je op Opslaan klikt. Sectie 21 koos
             bewust voor deze expliciete, herkenbare Opslaan-actie in plaats van automatisch
             opslaan bij elke toetsaanslag: dat laatste zou bij elk keystroke een save-cyclus
             (inclusief de gedeelde _saveLock in MainWindow) starten, met alle risico's van dien
             bij snel typen. -->
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{loc:Loc LabelUnsavedChanges}" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                       Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button DockPanel.Dock="Right" x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{Binding IsDirty}" Click="SaveButton_Click" ToolTip="{loc:Loc ButtonSave}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Check}" Fill="White" Stretch="Uniform"
                          Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc ButtonSave}" />
                </StackPanel>
            </Button>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc ScreenEditorPreviewDisclaimer}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,16" />

        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc ScreenEditorNoScreens}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,16"
                   Visibility="{Binding HasNoScreens, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <!-- Sterretjesbreedte met een minimum: dit is sinds sectie 21 het middendeel van
                     MainWindow, dus krijgt de meeste ruimte in het venster. -->
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Linkerkolom (sectie 21): schermselectie + voorvertoning ("scherminhoud"). Het
                 Standaardscherm in zijn eigen rij bovenaan, duidelijk visueel gescheiden door een
                 scheidingslijn (§12.7 — bewust geen "scherm nul" tussen de echte
                 installerschermen), daaronder de echte schermen in Inno Setup's eigen volgorde.
                 Geen aan/uit-vinkjes meer hier: welk scherm meedoet, wordt sinds sectie 21 in
                 Projectinstellingen bepaald (tabblad Schermen) — deze lijst toont alleen wat daar
                 al aan staat. Twee aparte ListBoxen die allebei naar dezelfde SelectedScreen
                 two-way-binden (2026-09-30: zie ScreenListBox_SelectionChanged in
                 ScreenEditorControl.xaml.cs voor waarom dat een expliciete handler nodig heeft in
                 plaats van vanzelf op te lossen). -->
            <DockPanel Grid.Column="0">
                <!-- SelectionChanged hieronder (ScreenListBox_SelectionChanged, zie
                     ScreenEditorControl.xaml.cs): twee ListBoxen die naar dezelfde SelectedScreen
                     two-way-binden lossen elkaars markering NIET vanzelf op zodra de gedeelde
                     waarde een item is dat niet in hun eigen ItemsSource zit — WPF's Selector
                     negeert een SelectedItem-toewijzing die geen match vindt in plaats van de
                     markering te wissen (bekende WPF-eigenaardigheid, geen gevolg van de
                     Standaardscherm/§12.7-ontwerpbeslissing zelf). Zonder deze handler bleef de
                     oude selectie zichtbaar gemarkeerd staan én kon je er met een muisklik niet
                     meer op terugkomen, omdat de ListBox intern nog dacht dat het al
                     geselecteerd was. -->
                <ListBox x:Name="DefaultScreenListBox" DockPanel.Dock="Top" ItemsSource="{Binding DefaultScreenRow}"
                         SelectedItem="{Binding SelectedScreen}" ItemTemplate="{StaticResource ScreenRowTemplate}"
                         SelectionChanged="ScreenListBox_SelectionChanged"
                         Background="Transparent" BorderThickness="0" />
                <Separator DockPanel.Dock="Top" Margin="6,4" />
                <ListBox x:Name="ScreensListBox" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}"
                         ItemTemplate="{StaticResource ScreenRowTemplate}"
                         SelectionChanged="ScreenListBox_SelectionChanged"
                         Background="Transparent" BorderThickness="0" />
            </DockPanel>

            <!-- Voorvertoning: een nabootsing van Inno Setup's eigen wizardvenster, met vaste
                 afmetingen en vaste (niet-thema-afhankelijke) kleuren, los van het scherm-VM-type
                 boven in UserControl.Resources. Terug/Volgende navigeert door Screens. -->
            <Border Grid.Column="2" Width="497" Height="400" VerticalAlignment="Top" BorderBrush="#FF888888" BorderThickness="1"
                    Background="#FFF0F0F0"
                    Visibility="{Binding IsRealScreenSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="#FFACA899" BorderThickness="0,1,0,0" Padding="10">
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Left"
                                    ToolTip="{Binding SelectedScreen.EffectiveCancelButtonTooltip}"
                                    IsEnabled="{Binding SelectedScreen.IsCancelButtonEnabled}"
                                    Visibility="{Binding SelectedScreen.IsCancelButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Foreground="{Binding SelectedScreen.EffectiveCancelButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    FontFamily="{Binding SelectedScreen.EffectiveCancelButtonFontFamily, Converter={StaticResource FontFamilyOrUnsetConverter}}"
                                    FontSize="{Binding SelectedScreen.EffectiveCancelButtonFontSize, Converter={StaticResource FontSizeOrUnsetConverter}}"
                                    FontWeight="{Binding SelectedScreen.EffectiveCancelButtonFontBold, Converter={StaticResource NullableBoolToFontWeightConverter}}"
                                    Padding="12,4" MinWidth="80">
                                <TextBlock Text="{Binding SelectedScreen.EffectiveCancelButtonCaption}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding BackCommand}"
                                        ToolTip="{Binding SelectedScreen.EffectiveBackButtonTooltip}"
                                        Visibility="{Binding SelectedScreen.IsBackButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Opacity="{Binding SelectedScreen.IsBackButtonEnabled, Converter={StaticResource BooleanToOpacityConverter}}"
                                        Foreground="{Binding SelectedScreen.EffectiveBackButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                                        FontFamily="{Binding SelectedScreen.EffectiveBackButtonFontFamily, Converter={StaticResource FontFamilyOrUnsetConverter}}"
                                        FontSize="{Binding SelectedScreen.EffectiveBackButtonFontSize, Converter={StaticResource FontSizeOrUnsetConverter}}"
                                        FontWeight="{Binding SelectedScreen.EffectiveBackButtonFontBold, Converter={StaticResource NullableBoolToFontWeightConverter}}"
                                        Padding="12,4" Margin="0,0,8,0" MinWidth="80">
                                    <TextBlock Text="{Binding SelectedScreen.EffectiveBackButtonCaption}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>

                                <Button Command="{Binding NextCommand}"
                                        ToolTip="{Binding SelectedScreen.EffectiveNextButtonTooltip}"
                                        Visibility="{Binding SelectedScreen.IsNextButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Opacity="{Binding SelectedScreen.IsNextButtonEnabled, Converter={StaticResource BooleanToOpacityConverter}}"
                                        Foreground="{Binding SelectedScreen.EffectiveNextButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                                        FontFamily="{Binding SelectedScreen.EffectiveNextButtonFontFamily, Converter={StaticResource FontFamilyOrUnsetConverter}}"
                                        FontSize="{Binding SelectedScreen.EffectiveNextButtonFontSize, Converter={StaticResource FontSizeOrUnsetConverter}}"
                                        FontWeight="{Binding SelectedScreen.EffectiveNextButtonFontBold, Converter={StaticResource NullableBoolToFontWeightConverter}}"
                                        Padding="12,4" MinWidth="80">
                                    <TextBlock Text="{Binding SelectedScreen.EffectiveNextButtonCaption}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ContentControl Content="{Binding SelectedScreen}" />
                </DockPanel>
            </Border>

            <!-- Vervangt de voorvertoning hierboven zodra het Standaardscherm geselecteerd is. -->
            <Border Grid.Column="2" Width="497" Height="400" VerticalAlignment="Top" BorderBrush="#FF888888" BorderThickness="1"
                    Background="#FFF0F0F0"
                    Visibility="{Binding IsDefaultScreenSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{loc:Loc ScreenEditorDefaultScreenInfo}" TextWrapping="Wrap"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="30"
                           Foreground="#FF666666" />
            </Border>

            <!-- Instellingenpaneel (middendeel): dezelfde SelectedScreen-instantie, maar dan met
                 de templates uit UserControl.Resources hierboven (LocalizationManager,
                 thema-brushes). Expliciete ContentTemplateSelector: zie
                 PropertyPanelTemplateSelector in InnoSetupStudio.App.Converters. -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding SelectedScreen}">
                    <ContentControl.ContentTemplateSelector>
                        <converters:PropertyPanelTemplateSelector
                            WelcomeTemplate="{StaticResource PropertyPanelTemplate}"
                            LicenseTemplate="{StaticResource LicensePropertyPanelTemplate}"
                            InfoBeforeTemplate="{StaticResource InfoBeforePropertyPanelTemplate}"
                            UserInfoTemplate="{StaticResource UserInfoPropertyPanelTemplate}"
                            SelectDestinationTemplate="{StaticResource SelectDestinationPropertyPanelTemplate}"
                            SelectProgramGroupTemplate="{StaticResource SelectProgramGroupPropertyPanelTemplate}"
                            ReadyTemplate="{StaticResource ReadyPropertyPanelTemplate}"
                            InfoAfterTemplate="{StaticResource InfoAfterPropertyPanelTemplate}"
                            DefaultScreenTemplate="{StaticResource DefaultScreenPropertyPanelTemplate}" />
                    </ContentControl.ContentTemplateSelector>
                </ContentControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
