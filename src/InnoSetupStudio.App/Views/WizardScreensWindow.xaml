<Window x:Class="InnoSetupStudio.App.Views.WizardScreensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InnoSetupStudio.App.Localization"
        xmlns:converters="clr-namespace:InnoSetupStudio.App.Converters"
        Title="{loc:Loc WizardScreensTitle}" Height="620" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}">
    <Window.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" ToolTip="{loc:Loc ButtonSave}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Check}" Fill="White" Stretch="Uniform"
                          Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc ButtonSave}" />
                </StackPanel>
            </Button>
            <Button Command="{Binding CancelCommand}" ToolTip="{loc:Loc ButtonCancel}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Close}" Fill="{DynamicResource Brush.TextPrimary}"
                          Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc ButtonCancel}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc WizardScreensIntro}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,16" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Screens}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4"
                                        Background="{DynamicResource Brush.SurfaceAlt}" Margin="0,0,12,0">
                                    <Path Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                                          Fill="{DynamicResource Brush.TextSecondary}" Stretch="Uniform"
                                          Width="16" Height="16" />
                                </Border>

                                <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                           FontSize="14" />

                                <CheckBox Grid.Column="3" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding DisplayName}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
