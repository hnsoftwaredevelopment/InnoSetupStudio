<Window x:Class="InnoSetupStudio.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InnoSetupStudio.App.Localization"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Width="420" Height="220" Icon="/Resources/AppIcon.ico"
        Background="{DynamicResource Brush.Background}">
    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Margin="1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Het app-icoon is een SVG met gradients en boogsegmenten (zie AppIcon.svg), dus
                 gerenderd via SharpVectors in plaats van als handgeschreven Geometry zoals de
                 rechte-lijnen UI-iconen in Icons.xaml. -->
            <svgc:SvgViewbox Source="/Resources/AppIcon.svg" Width="56" Height="56" Margin="0,0,20,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc AppTitle}" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock x:Name="VersionText" FontSize="13" Margin="0,10,0,0"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
