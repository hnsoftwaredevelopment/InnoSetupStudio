<Window x:Class="InnoSetupStudio.App.Views.WizardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InnoSetupStudio.App.Localization"
        xmlns:converters="clr-namespace:InnoSetupStudio.App.Converters"
        xmlns:vm="clr-namespace:InnoSetupStudio.App.ViewModels.Screens"
        xmlns:wizard="clr-namespace:InnoSetupStudio.Wizard.Screens;assembly=InnoSetupStudio.Wizard"
        Title="{loc:Loc ScreenEditorTitle}" Height="600" Width="980"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}">
    <Window.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Voorvertoning (midden): per schermtype de bijbehorende UserControl uit
             InnoSetupStudio.Wizard. Die controls kennen deze ViewModel-klassen niet (Wizard
             verwijst alleen naar Core, niet naar App, om een cirkelverwijzing met App te
             voorkomen); de binding werkt via de DataContext die WPF hier automatisch doorgeeft,
             niet via een compile-time koppeling. -->
        <DataTemplate DataType="{x:Type vm:WelcomePageEditorViewModel}">
            <wizard:WelcomePagePreview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LicensePageEditorViewModel}">
            <wizard:LicensePagePreview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SelectDestinationPageEditorViewModel}">
            <wizard:SelectDestinationPagePreview />
        </DataTemplate>

        <!-- Instellingenpaneel (rechts): staat wél hier in InnoSetupStudio.App, want dit gebruikt
             LocalizationManager (via loc:Loc) en de thema-brushes van de studio zelf — in
             tegenstelling tot de voorvertoning hierboven, die bewust Inno Setup's eigen vaste
             wit/zwart-kleuren gebruikt in plaats van het thema van de studio. -->
        <DataTemplate DataType="{x:Type vm:WelcomePageEditorViewModel}" x:Key="PropertyPanelTemplate">
            <TextBlock Text="{loc:Loc ScreenEditorWelcomeInfo}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LicensePageEditorViewModel}" x:Key="LicensePropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc LabelLicenseFilePath}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding LicenseFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Command="{Binding BrowseCommand}" ToolTip="{loc:Loc ButtonBrowse}"
                            AutomationProperties.Name="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SelectDestinationPageEditorViewModel}" x:Key="SelectDestinationPropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc LabelDefaultDirName}" Margin="0,0,0,6" />
                <TextBox Text="{Binding DefaultDirName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                <TextBlock Text="{loc:Loc LabelDefaultDirNameHint}" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,16" />
                <CheckBox Content="{loc:Loc LabelAllowUserToChangeDir}" IsChecked="{Binding AllowUserToChangeDir}"
                          Foreground="{DynamicResource Brush.TextPrimary}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" ToolTip="{loc:Loc ButtonSave}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Check}" Fill="White" Stretch="Uniform"
                          Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc ButtonSave}" />
                </StackPanel>
            </Button>
            <Button Command="{Binding CancelCommand}" ToolTip="{Binding CancelButtonText}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{Binding CancelButtonIconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                          Fill="{DynamicResource Brush.TextPrimary}"
                          Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding CancelButtonText}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc ScreenEditorPreviewDisclaimer}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,16" />

        <!-- Geen van de nog ondersteunde schermen staat aan: toelichting in plaats van de drie
             lege panelen. HasNoScreens is de expliciete tegenhanger van HasScreens hieronder,
             puur om hier geen tweede (inverterende) converter voor te hoeven schrijven. -->
        <TextBlock Text="{loc:Loc ScreenEditorNoScreens}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   Visibility="{Binding HasNoScreens, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Visibility="{Binding HasScreens, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>

            <!-- Linkerlijst: de schermen in Inno Setup's eigen volgorde. -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                                  Fill="{DynamicResource Brush.TextSecondary}" Stretch="Uniform"
                                  Width="14" Height="14" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Voorvertoning: een nabootsing van Inno Setup's eigen wizardvenster, met vaste
                 afmetingen en vaste (niet-thema-afhankelijke) kleuren, los van het scherm-VM-type
                 boven in Window.Resources. Terug/Volgende navigeert door Screens; een echte
                 Annuleren-knop staat hier bewust niet bij, om verwarring met de Opslaan/Sluiten-
                 knoppen van dit venster zelf te voorkomen. -->
            <Border Grid.Column="2" Width="497" Height="400" BorderBrush="#FF888888" BorderThickness="1"
                    Background="#FFF0F0F0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="#FFACA899" BorderThickness="0,1,0,0" Padding="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:Loc ButtonWizardBack}" Command="{Binding BackCommand}"
                                    Padding="12,4" Margin="0,0,8,0" MinWidth="80" />
                            <Button Content="{loc:Loc ButtonWizardNext}" Command="{Binding NextCommand}"
                                    Padding="12,4" MinWidth="80" />
                        </StackPanel>
                    </Border>
                    <ContentControl Content="{Binding SelectedScreen}" />
                </DockPanel>
            </Border>

            <!-- Instellingenpaneel: dezelfde SelectedScreen-instantie, maar dan met de templates
                 uit Window.Resources hierboven (LocalizationManager, thema-brushes). -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <!-- Zelfde instantie als de voorvertoning hiernaast, maar met een
                     expliciete ContentTemplateSelector in plaats van WPF's automatische, keyless
                     DataType-matching: met keyless templates zou hetzelfde VM-type niet twee
                     verschillende templates (voorvertoning vs. instellingenpaneel) kunnen krijgen,
                     de laatst-gevonden template zou dan overal gebruikt worden. Zie
                     PropertyPanelTemplateSelector in InnoSetupStudio.App.Converters. -->
                <ContentControl Content="{Binding SelectedScreen}">
                    <ContentControl.ContentTemplateSelector>
                        <converters:PropertyPanelTemplateSelector
                            WelcomeTemplate="{StaticResource PropertyPanelTemplate}"
                            LicenseTemplate="{StaticResource LicensePropertyPanelTemplate}"
                            SelectDestinationTemplate="{StaticResource SelectDestinationPropertyPanelTemplate}" />
                    </ContentControl.ContentTemplateSelector>
                </ContentControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
