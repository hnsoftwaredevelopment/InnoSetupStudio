<Window x:Class="InnoSetupStudio.App.Views.WizardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InnoSetupStudio.App.Localization"
        xmlns:converters="clr-namespace:InnoSetupStudio.App.Converters"
        xmlns:vm="clr-namespace:InnoSetupStudio.App.ViewModels.Screens"
        xmlns:wizard="clr-namespace:InnoSetupStudio.Wizard.Screens;assembly=InnoSetupStudio.Wizard"
        Title="{loc:Loc ScreenEditorTitle}" Height="600" Width="980"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}">
    <Window.Resources>
        <converters:IconKeyToGeometryConverter x:Key="IconKeyToGeometryConverter" />
        <converters:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
        <converters:FontFamilyOrUnsetConverter x:Key="FontFamilyOrUnsetConverter" />
        <converters:FontSizeOrUnsetConverter x:Key="FontSizeOrUnsetConverter" />
        <converters:NullableBoolToFontWeightConverter x:Key="NullableBoolToFontWeightConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Gedeeld door beide lijsten hieronder (het Standaardscherm bovenaan en de echte
             installerschermen eronder): icoon + naam, hetzelfde voor allebei. Beide VM-typen
             (DefaultScreenEditorViewModel en WizardScreenEditorViewModel) hebben een Title- en
             IconKey-eigenschap met dezelfde naam, dus deze ene template werkt voor beide zonder
             DataType-onderscheid. -->
        <DataTemplate x:Key="ScreenRowTemplate">
            <Grid Margin="6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                      Fill="{DynamicResource Brush.TextSecondary}" Stretch="Uniform"
                      Width="14" Height="14" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <!-- Gedeeld door alle drie de instellingenpanelen hieronder (Welkom/Licentie/Bestemming):
             Terug-/Volgende-/Annuleren-knop per scherm aanpasbaar maken. Staat op de basisklasse
             WizardScreenEditorViewModel, dus deze template werkt voor elk schermtype zonder een
             eigen kopie per scherm. -->
        <DataTemplate x:Key="ButtonSettingsSectionTemplate">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="{loc:Loc SectionWizardButtons}" FontWeight="Bold" Margin="0,0,0,8" />

                <TextBlock x:Name="BackButtonCaptionLabel" Text="{loc:Loc LabelBackButtonSection}" Margin="0,0,0,4" />
                <TextBox Text="{Binding BackButtonCaption, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                         AutomationProperties.LabeledBy="{Binding ElementName=BackButtonCaptionLabel}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Content="{loc:Loc LabelButtonEnabled}" IsChecked="{Binding BackButtonEnabled}"
                              IsThreeState="True" Margin="0,0,16,0" />
                    <CheckBox Content="{loc:Loc LabelButtonVisible}" IsChecked="{Binding BackButtonVisible}"
                              IsThreeState="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc LabelButtonTextColor}" Width="96" VerticalAlignment="Center" />
                    <Border Width="18" Height="18" BorderBrush="#FFACA899" BorderThickness="1" Margin="0,0,4,0"
                            Background="{Binding BackButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}" />
                    <TextBox Width="90" Text="{Binding BackButtonTextColor, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc LabelButtonFontFamily}" Width="96" VerticalAlignment="Center" />
                    <TextBox Width="120" Text="{Binding BackButtonFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc LabelButtonFontSize}" Width="96" VerticalAlignment="Center" />
                    <TextBox Width="50" Text="{Binding BackButtonFontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                    <CheckBox Content="{loc:Loc LabelButtonFontBold}" IsChecked="{Binding BackButtonFontBold}" IsThreeState="True" />
                </StackPanel>

                <TextBlock x:Name="NextButtonCaptionLabel" Text="{loc:Loc LabelNextButtonSection}" Margin="0,12,0,4" />
                <TextBox Text="{Binding NextButtonCaption, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                         AutomationProperties.LabeledBy="{Binding ElementName=NextButtonCaptionLabel}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Content="{loc:Loc LabelButtonEnabled}" IsChecked="{Binding NextButtonEnabled}"
                              IsThreeState="True" Margin="0,0,16,0" />
                    <CheckBox Content="{loc:Loc LabelButtonVisible}" IsChecked="{Binding NextButtonVisible}"
                              IsThreeState="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc LabelButtonTextColor}" Width="96" VerticalAlignment="Center" />
                    <Border Width="18" Height="18" BorderBrush="#FFACA899" BorderThickness="1" Margin="0,0,4,0"
                            Background="{Binding NextButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}" />
                    <TextBox Width="90" Text="{Binding NextButtonTextColor, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc LabelButtonFontFamily}" Width="96" VerticalAlignment="Center" />
                    <TextBox Width="120" Text="{Binding NextButtonFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc LabelButtonFontSize}" Width="96" VerticalAlignment="Center" />
                    <TextBox Width="50" Text="{Binding NextButtonFontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                    <CheckBox Content="{loc:Loc LabelButtonFontBold}" IsChecked="{Binding NextButtonFontBold}" IsThreeState="True" />
                </StackPanel>

                <TextBlock x:Name="CancelButtonCaptionLabel" Text="{loc:Loc LabelCancelButtonSection}" Margin="0,12,0,4" />
                <TextBox Text="{Binding CancelButtonCaption, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                         AutomationProperties.LabeledBy="{Binding ElementName=CancelButtonCaptionLabel}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Content="{loc:Loc LabelButtonEnabled}" IsChecked="{Binding CancelButtonEnabled}"
                              IsThreeState="True" Margin="0,0,16,0" />
                    <CheckBox Content="{loc:Loc LabelButtonVisible}" IsChecked="{Binding CancelButtonVisible}"
                              IsThreeState="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc LabelButtonTextColor}" Width="96" VerticalAlignment="Center" />
                    <Border Width="18" Height="18" BorderBrush="#FFACA899" BorderThickness="1" Margin="0,0,4,0"
                            Background="{Binding CancelButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}" />
                    <TextBox Width="90" Text="{Binding CancelButtonTextColor, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc LabelButtonFontFamily}" Width="96" VerticalAlignment="Center" />
                    <TextBox Width="120" Text="{Binding CancelButtonFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc LabelButtonFontSize}" Width="96" VerticalAlignment="Center" />
                    <TextBox Width="50" Text="{Binding CancelButtonFontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                    <CheckBox Content="{loc:Loc LabelButtonFontBold}" IsChecked="{Binding CancelButtonFontBold}" IsThreeState="True" />
                </StackPanel>

                <TextBlock Text="{Binding HintButtonCaptionEmptyText}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding HintButtonTriStateText}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
                <TextBlock Text="{loc:Loc HintButtonColorFormat}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Voorvertoning (midden): per schermtype de bijbehorende UserControl uit
             InnoSetupStudio.Wizard. Die controls kennen deze ViewModel-klassen niet (Wizard
             verwijst alleen naar Core, niet naar App, om een cirkelverwijzing met App te
             voorkomen); de binding werkt via de DataContext die WPF hier automatisch doorgeeft,
             niet via een compile-time koppeling. -->
        <DataTemplate DataType="{x:Type vm:WelcomePageEditorViewModel}">
            <wizard:WelcomePagePreview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LicensePageEditorViewModel}">
            <wizard:LicensePagePreview />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SelectDestinationPageEditorViewModel}">
            <wizard:SelectDestinationPagePreview />
        </DataTemplate>

        <!-- Instellingenpaneel (rechts): staat wél hier in InnoSetupStudio.App, want dit gebruikt
             LocalizationManager (via loc:Loc) en de thema-brushes van de studio zelf — in
             tegenstelling tot de voorvertoning hierboven, die bewust Inno Setup's eigen vaste
             wit/zwart-kleuren gebruikt in plaats van het thema van de studio. -->
        <DataTemplate DataType="{x:Type vm:WelcomePageEditorViewModel}" x:Key="PropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc ScreenEditorWelcomeInfo}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonSettingsSectionTemplate}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LicensePageEditorViewModel}" x:Key="LicensePropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc LabelLicenseFilePath}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding LicenseFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Command="{Binding BrowseCommand}" ToolTip="{loc:Loc ButtonBrowse}"
                            AutomationProperties.Name="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonSettingsSectionTemplate}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SelectDestinationPageEditorViewModel}" x:Key="SelectDestinationPropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc LabelDefaultDirName}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding DefaultDirName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Command="{Binding BrowseCommand}" ToolTip="{loc:Loc ButtonBrowse}"
                            AutomationProperties.Name="{loc:Loc ButtonBrowse}">
                        <Path Data="{StaticResource Folder}" Fill="{DynamicResource Brush.TextPrimary}"
                              Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </Grid>
                <TextBlock Text="{loc:Loc LabelDefaultDirNameHint}" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,16" />
                <CheckBox Content="{loc:Loc LabelAllowUserToChangeDir}" IsChecked="{Binding AllowUserToChangeDir}"
                          Foreground="{DynamicResource Brush.TextPrimary}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonSettingsSectionTemplate}" />

                <!-- Schermspecifieke "Bladeren"-knop (Inno Setup's WizardForm.DirBrowseButton,
                     zie BrowseButtonSettings): bewust een eigen sectie, los van
                     ButtonSettingsSectionTemplate hierboven (Terug/Volgende/Annuleren) — deze knop
                     komt maar op dit scherm voor en heeft geen Caption. -->
                <TextBlock Text="{loc:Loc SectionBrowseButton}" FontWeight="Bold" Margin="0,20,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Content="{loc:Loc LabelButtonEnabled}" IsChecked="{Binding BrowseButtonEnabled}"
                              IsThreeState="True" Margin="0,0,16,0" />
                    <CheckBox Content="{loc:Loc LabelButtonVisible}" IsChecked="{Binding BrowseButtonVisible}"
                              IsThreeState="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc LabelButtonTextColor}" Width="96" VerticalAlignment="Center" />
                    <Border Width="18" Height="18" BorderBrush="#FFACA899" BorderThickness="1" Margin="0,0,4,0"
                            Background="{Binding BrowseButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}" />
                    <TextBox Width="90" Text="{Binding BrowseButtonTextColor, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc LabelButtonFontFamily}" Width="96" VerticalAlignment="Center" />
                    <TextBox Width="120" Text="{Binding BrowseButtonFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc LabelButtonFontSize}" Width="96" VerticalAlignment="Center" />
                    <TextBox Width="50" Text="{Binding BrowseButtonFontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                    <CheckBox Content="{loc:Loc LabelButtonFontBold}" IsChecked="{Binding BrowseButtonFontBold}" IsThreeState="True" />
                </StackPanel>
                <TextBlock Text="{loc:Loc HintButtonColorFormat}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Het Standaardscherm (§12.6/§12.7): geen eigen velden buiten de negen knopvelden, dus
             alleen de toelichting plus dezelfde ButtonSettingsSectionTemplate als de drie echte
             schermen hierboven — dit VM-type heeft dezelfde negen eigenschapsnamen (zie
             DefaultScreenEditorViewModel), dus de gedeelde template werkt hier ongewijzigd. -->
        <DataTemplate DataType="{x:Type vm:DefaultScreenEditorViewModel}" x:Key="DefaultScreenPropertyPanelTemplate">
            <StackPanel>
                <TextBlock Text="{loc:Loc ScreenEditorDefaultScreenInfo}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonSettingsSectionTemplate}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" ToolTip="{loc:Loc ButtonSave}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Check}" Fill="White" Stretch="Uniform"
                          Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc ButtonSave}" />
                </StackPanel>
            </Button>
            <Button Command="{Binding CancelCommand}" ToolTip="{Binding CancelButtonText}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{Binding CancelButtonIconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                          Fill="{DynamicResource Brush.TextPrimary}"
                          Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding CancelButtonText}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc ScreenEditorPreviewDisclaimer}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,16" />

        <!-- Geen van de nog ondersteunde schermen staat aan: aanvullende toelichting BOVEN de
             editor, niet in plaats ervan — het Standaardscherm hieronder bestaat en is bewerkbaar
             ongeacht welke echte schermen aan staan (zie WizardEditorViewModel.HasScreens), dus de
             Grid hieronder blijft altijd zichtbaar. HasNoScreens is de expliciete tegenhanger van
             HasScreens, puur om hier geen tweede (inverterende) converter voor te hoeven
             schrijven. -->
        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc ScreenEditorNoScreens}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,16"
                   Visibility="{Binding HasNoScreens, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>

            <!-- Linkerlijst: het Standaardscherm in zijn eigen rij bovenaan, duidelijk visueel
                 gescheiden door een scheidingslijn (§12.7 — bewust geen "scherm nul" tussen de
                 echte installerschermen), daaronder de echte schermen in Inno Setup's eigen
                 volgorde. Twee aparte ListBoxen die allebei naar dezelfde SelectedScreen
                 two-way-binden: selecteer je een item in de ene lijst, dan verliest de andere zijn
                 markering vanzelf (SelectedItem vindt daar dan geen match), zonder dat daar extra
                 code voor nodig is. -->
            <DockPanel Grid.Column="0">
                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding DefaultScreenRow}"
                         SelectedItem="{Binding SelectedScreen}" ItemTemplate="{StaticResource ScreenRowTemplate}"
                         Background="Transparent" BorderThickness="0" />
                <Separator DockPanel.Dock="Top" Margin="6,4" />
                <ListBox ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}"
                         ItemTemplate="{StaticResource ScreenRowTemplate}"
                         Background="Transparent" BorderThickness="0" />
            </DockPanel>

            <!-- Voorvertoning: een nabootsing van Inno Setup's eigen wizardvenster, met vaste
                 afmetingen en vaste (niet-thema-afhankelijke) kleuren, los van het scherm-VM-type
                 boven in Window.Resources. Terug/Volgende navigeert door Screens. De Annuleren-knop
                 hieronder heeft, anders dan de Opslaan/Sluiten-knoppen van dit venster zelf, geen
                 eigen functie (geen Command) — die staat er puur om de eigen Caption/Enabled/
                 Visible-instellingen van het geselecteerde scherm te kunnen voorvertonen, zie
                 ButtonSettingsSectionTemplate hierboven. -->
            <Border Grid.Column="2" Width="497" Height="400" BorderBrush="#FF888888" BorderThickness="1"
                    Background="#FFF0F0F0"
                    Visibility="{Binding IsRealScreenSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <!-- Nabootsing van Inno Setup's eigen knoppenbalk: Annuleren links, Terug/Volgende
                         rechts. Terug/Volgende blijven de echte navigatie van de schermeditor (zie
                         WizardEditorViewModel.Back/Next) en tonen daarom hun eventuele uitgeschakeld-
                         zijn alleen als gedimd uiterlijk (Opacity), niet als echte IsEnabled — anders
                         zou navigeren door de schermeditor zelf stuklopen op een scherm waar de
                         gebruiker Volgende voor de installer heeft uitgeschakeld. Annuleren heeft in
                         de schermeditor geen eigen functie, dus die knop gebruikt de eigenschap wél
                         als echte IsEnabled. -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="#FFACA899" BorderThickness="0,1,0,0" Padding="10">
                        <DockPanel LastChildFill="False">
                            <!-- Foreground/FontFamily/FontSize/FontWeight: EffectiveXxxTextColor/
                                 -FontFamily/-FontSize/-FontBold (backlogitem 3, sectie 14). Leeg/
                                 null geeft UnsetValue terug (zie HexColorToBrushConverter/
                                 FontFamilyOrUnsetConverter/FontSizeOrUnsetConverter/
                                 NullableBoolToFontWeightConverter), dus de knop valt dan gewoon
                                 terug op zijn eigen standaard WPF-uiterlijk. Geen Background-
                                 binding meer: TNewButton is een door Windows getekende
                                 standaardknop, een achtergrondkleur/bitmap is bewust geschrapt
                                 (zie WizardScreenButtonSettings). -->
                            <Button DockPanel.Dock="Left" Content="{Binding SelectedScreen.EffectiveCancelButtonCaption}"
                                    IsEnabled="{Binding SelectedScreen.IsCancelButtonEnabled}"
                                    Visibility="{Binding SelectedScreen.IsCancelButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Foreground="{Binding SelectedScreen.EffectiveCancelButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                                    FontFamily="{Binding SelectedScreen.EffectiveCancelButtonFontFamily, Converter={StaticResource FontFamilyOrUnsetConverter}}"
                                    FontSize="{Binding SelectedScreen.EffectiveCancelButtonFontSize, Converter={StaticResource FontSizeOrUnsetConverter}}"
                                    FontWeight="{Binding SelectedScreen.EffectiveCancelButtonFontBold, Converter={StaticResource NullableBoolToFontWeightConverter}}"
                                    Padding="12,4" MinWidth="80" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{Binding SelectedScreen.EffectiveBackButtonCaption}" Command="{Binding BackCommand}"
                                        Visibility="{Binding SelectedScreen.IsBackButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Opacity="{Binding SelectedScreen.IsBackButtonEnabled, Converter={StaticResource BooleanToOpacityConverter}}"
                                        Foreground="{Binding SelectedScreen.EffectiveBackButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                                        FontFamily="{Binding SelectedScreen.EffectiveBackButtonFontFamily, Converter={StaticResource FontFamilyOrUnsetConverter}}"
                                        FontSize="{Binding SelectedScreen.EffectiveBackButtonFontSize, Converter={StaticResource FontSizeOrUnsetConverter}}"
                                        FontWeight="{Binding SelectedScreen.EffectiveBackButtonFontBold, Converter={StaticResource NullableBoolToFontWeightConverter}}"
                                        Padding="12,4" Margin="0,0,8,0" MinWidth="80" />
                                <Button Content="{Binding SelectedScreen.EffectiveNextButtonCaption}" Command="{Binding NextCommand}"
                                        Visibility="{Binding SelectedScreen.IsNextButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Opacity="{Binding SelectedScreen.IsNextButtonEnabled, Converter={StaticResource BooleanToOpacityConverter}}"
                                        Foreground="{Binding SelectedScreen.EffectiveNextButtonTextColor, Converter={StaticResource HexColorToBrushConverter}}"
                                        FontFamily="{Binding SelectedScreen.EffectiveNextButtonFontFamily, Converter={StaticResource FontFamilyOrUnsetConverter}}"
                                        FontSize="{Binding SelectedScreen.EffectiveNextButtonFontSize, Converter={StaticResource FontSizeOrUnsetConverter}}"
                                        FontWeight="{Binding SelectedScreen.EffectiveNextButtonFontBold, Converter={StaticResource NullableBoolToFontWeightConverter}}"
                                        Padding="12,4" MinWidth="80" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ContentControl Content="{Binding SelectedScreen}" />
                </DockPanel>
            </Border>

            <!-- Vervangt de voorvertoning hierboven zodra het Standaardscherm geselecteerd is: dat
                 stelt geen bestaand installerscherm voor, dus geen 1-op-1 Inno Setup-nabootsing
                 zoals de andere schermen (§12.6 liet deze vraag open; dit is voorlopig de
                 eenvoudigste van de twee genoemde opties, zie DefaultScreenEditorViewModel). -->
            <Border Grid.Column="2" Width="497" Height="400" BorderBrush="#FF888888" BorderThickness="1"
                    Background="#FFF0F0F0"
                    Visibility="{Binding IsDefaultScreenSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{loc:Loc ScreenEditorDefaultScreenInfo}" TextWrapping="Wrap"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="30"
                           Foreground="#FF666666" />
            </Border>

            <!-- Instellingenpaneel: dezelfde SelectedScreen-instantie, maar dan met de templates
                 uit Window.Resources hierboven (LocalizationManager, thema-brushes). -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <!-- Zelfde instantie als de voorvertoning hiernaast, maar met een
                     expliciete ContentTemplateSelector in plaats van WPF's automatische, keyless
                     DataType-matching: met keyless templates zou hetzelfde VM-type niet twee
                     verschillende templates (voorvertoning vs. instellingenpaneel) kunnen krijgen,
                     de laatst-gevonden template zou dan overal gebruikt worden. Zie
                     PropertyPanelTemplateSelector in InnoSetupStudio.App.Converters. -->
                <ContentControl Content="{Binding SelectedScreen}">
                    <ContentControl.ContentTemplateSelector>
                        <converters:PropertyPanelTemplateSelector
                            WelcomeTemplate="{StaticResource PropertyPanelTemplate}"
                            LicenseTemplate="{StaticResource LicensePropertyPanelTemplate}"
                            SelectDestinationTemplate="{StaticResource SelectDestinationPropertyPanelTemplate}"
                            DefaultScreenTemplate="{StaticResource DefaultScreenPropertyPanelTemplate}" />
                    </ContentControl.ContentTemplateSelector>
                </ContentControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
