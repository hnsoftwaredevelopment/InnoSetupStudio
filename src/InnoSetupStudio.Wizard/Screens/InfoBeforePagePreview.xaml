<UserControl x:Class="InnoSetupStudio.Wizard.Screens.InfoBeforePagePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="455" d:DesignHeight="290">
    <!-- Zelfde vaste wit/zwart-kleurstelling als WelcomePagePreview, zie de toelichting daar.
         Verder bijna identiek aan LicensePagePreview (kop + scheidingslijn + memo-vak), maar
         zonder de "akkoord"-keuzerondjes: de Info Before-pagina is puur informatief, Inno Setup
         toont hier alleen een Volgende-knop. -->
    <DockPanel Background="White" Margin="20,16,20,20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Information" FontWeight="Bold" FontSize="13" Foreground="Black" />
                <TextBlock Margin="0,4,0,0" Foreground="Black" TextWrapping="Wrap"
                           Text="Please read the following important information before continuing." />
            </StackPanel>
            <Image Grid.Column="1" Source="{Binding WizardSmallImage}" Stretch="Uniform"
                   Width="55" Height="55" Margin="12,0,0,0" VerticalAlignment="Top" />
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="#FFACA899" Margin="0,0,0,12" />

        <Border BorderBrush="#FFACA899" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White">
                <TextBlock Text="{Binding InfoText}" TextWrapping="Wrap" Margin="6"
                           FontFamily="Consolas" FontSize="11" Foreground="Black" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
