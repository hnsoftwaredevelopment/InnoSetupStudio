<UserControl x:Class="InnoSetupStudio.Wizard.Screens.ReadyPagePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="455" d:DesignHeight="290">
    <!-- Zelfde vaste wit/zwart-kleurstelling als WelcomePagePreview, zie de toelichting daar.
         Het memo-vak hieronder is Inno Setup's eigen ReadyMemo: een illustratieve, statische
         samenvattingstekst (geen live gegenereerde tekst — dat is generatorwerk, fase 5/6),
         puur om te laten zien dat DisableReadyMemo dit hele vak verbergt. AlwaysShowDirOnReadyPage/
         AlwaysShowGroupOnReadyPage hebben geen eigen zichtbaar element hier: ze bepalen alleen of
         de (nog te bouwen) generator die twee regels in de écht gegenereerde samenvatting opneemt
         wanneer de bijbehorende pagina is overgeslagen. -->
    <DockPanel Background="White" Margin="20,16,20,20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Ready to Install" FontWeight="Bold" FontSize="13" Foreground="Black" />
                <TextBlock Margin="0,4,0,0" Foreground="Black" TextWrapping="Wrap"
                           Text="Setup is now ready to begin installing on your computer." />
            </StackPanel>
            <Image Grid.Column="1" Source="{Binding WizardSmallImage}" Stretch="Uniform"
                   Width="55" Height="55" Margin="12,0,0,0" VerticalAlignment="Top" />
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="#FFACA899" Margin="0,0,0,12" />

        <TextBlock DockPanel.Dock="Top" Foreground="Black" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Click Install to continue with the installation, or click Back if you want to review or change any settings." />

        <Border BorderBrush="#FFACA899" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DisableReadyMemo}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White">
                <TextBlock TextWrapping="Wrap" Margin="6" FontFamily="Consolas" FontSize="11" Foreground="Black"
                           Text="Destination location:&#x0a;    C:\Program Files\Application&#x0a;&#x0a;Start Menu folder:&#x0a;    Application" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
