<UserControl x:Class="InnoSetupStudio.Wizard.Screens.UserInfoPagePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="455" d:DesignHeight="290">
    <!-- Zelfde vaste wit/zwart-kleurstelling als WelcomePagePreview, zie de toelichting daar. -->
    <DockPanel Background="White" Margin="20,16,20,20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="User Information" FontWeight="Bold" FontSize="13" Foreground="Black" />
                <TextBlock Margin="0,4,0,0" Foreground="Black" TextWrapping="Wrap"
                           Text="Please enter your information." />
            </StackPanel>
            <Image Grid.Column="1" Source="{Binding WizardSmallImage}" Stretch="Uniform"
                   Width="55" Height="55" Margin="12,0,0,0" VerticalAlignment="Top" />
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="#FFACA899" Margin="0,0,0,20" />

        <!-- Drie vooringevulde tekstvelden, niet-interactief in de voorvertoning (bewerken
             gebeurt in het instellingenpaneel rechts): zelfde IsHitTestVisible/Focusable/
             IsTabStop-patroon als de "Bladeren"-knop in SelectDestinationPagePreview. -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="&amp;Full Name:" Foreground="Black" Margin="0,0,0,4" />
            <TextBox Text="{Binding DefaultUserInfoName, Mode=OneWay}" Margin="0,0,0,12"
                      IsHitTestVisible="False" Focusable="False" IsTabStop="False" />

            <TextBlock Text="&amp;Organization:" Foreground="Black" Margin="0,0,0,4" />
            <TextBox Text="{Binding DefaultUserInfoOrg, Mode=OneWay}" Margin="0,0,0,12"
                      IsHitTestVisible="False" Focusable="False" IsTabStop="False" />

            <TextBlock Text="Serial &amp;Number:" Foreground="Black" Margin="0,0,0,4" />
            <TextBox Text="{Binding DefaultUserInfoSerial, Mode=OneWay}"
                      IsHitTestVisible="False" Focusable="False" IsTabStop="False" />
        </StackPanel>
    </DockPanel>
</UserControl>
