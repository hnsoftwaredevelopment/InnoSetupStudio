<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>nl-NL</NeutralLanguage>
    <Company>HN Software Development</Company>
    <Product>Inno Setup Studio</Product>
    <!-- Anders plakt de .NET SDK automatisch "+<git-commit-sha>" achter InformationalVersion,
         wat op het splashscreen een lelijke lange hash naast het releasenummer laat zien. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Alleen de standaardwaarde voor een verse clone die nog nooit via build\Build.ps1 is
       gebouwd. Het echte, berekende versienummer wordt bewust pas in Directory.Build.targets
       geïmporteerd (zie dat bestand voor waarom), niet hier. -->
  <PropertyGroup Condition="'$(AssemblyVersion)' == ''">
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0.0 (dev)</InformationalVersion>
  </PropertyGroup>

</Project>
